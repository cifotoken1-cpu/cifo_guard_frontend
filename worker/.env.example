# ── Camera ─────────────────────────────────────────────────────────────────
# RTSP URL from VIGI C240 (or any ONVIF camera)
# Format: rtsp://<user>:<pass>@<ip>:<port>/<stream>
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1

# Camera ID must match backend cameras table (cameras.id)
CAMERA_ID=C240-01

# ── Backend API ─────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001/api

# JWT token for worker to authenticate against backend
# Generate: POST /api/auth/login with service account credentials
BACKEND_TOKEN=your-jwt-token-here

# ── Detection ───────────────────────────────────────────────────────────────
# YOLO model — yolov8n.pt (nano, fastest), yolov8s.pt (small, more accurate)
MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# ── Virtual Line ────────────────────────────────────────────────────────────
# Axis of virtual line: "y" = horizontal line, "x" = vertical line
LINE_AXIS=y

# Pixel coordinate of the line (use SHOW_PREVIEW=true to calibrate)
LINE_POSITION=400

# Direction mapping:
# "standard": crossing forward = "in", backward = "out"
# "reverse":  crossing forward = "out", backward = "in"
# Adjust based on camera orientation at door/gate
LINE_DIRECTION_MODE=standard

# Minimum pixels object must travel past line before counting (anti-jitter)
CROSSING_THRESHOLD_PX=10

# ── Worker ──────────────────────────────────────────────────────────────────
# Seconds to wait before reconnecting on RTSP failure
RECONNECT_DELAY=5

# Show cv2 preview window (requires display — disable in Docker/headless)
SHOW_PREVIEW=false
