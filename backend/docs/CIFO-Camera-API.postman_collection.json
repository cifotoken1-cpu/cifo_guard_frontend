    {
      "name": "🤖 Vigi AI (C240-01 @ 192.168.0.60)",
      "description": "Registrasi dan monitoring kamera Vigi AI.\nCamera ID: C240-01 (dari VIGI_CAMERA_ID di .env)\nURL DB endpoint memakai /api/api/cameras/* (double prefix — lihat folder Database).",
      "item": [
        {
          "name": "GET Cek Registrasi C240-01",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/api/cameras/{{vigi_camera_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "api", "cameras", "{{vigi_camera_id}}"]
