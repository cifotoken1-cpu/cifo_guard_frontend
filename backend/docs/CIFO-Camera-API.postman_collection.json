              "path": ["api", "api", "cameras"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"cam-test-01\",\n  \"name\": \"CCTV Test Lokasi Baru\",\n  \"label\": \"CCTV Test Lokasi Baru\",\n  \"ip_address\": \"192.168.1.100\",\n  \"location\": \"Lokasi Test\",\n  \"area\": \"Bandung\",\n  \"lat\": -6.9200000,\n  \"lng\": 107.6100000,\n  \"stream_url\": \"/video/TEST/test-cam.m3u8\",\n  \"status\": \"offline\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "🐛 WORKAROUND Bug #2 — Controller/Model field mismatch:\n\nController (CameraController.js:79) memvalidasi: name, ip_address, location, area\nModel (Camera.js) menggunakan: id, label, area, lat, lng, stream_url\n\nWorkaround: kirim KEDUA set field sekaligus.\n- name + ip_address + location → memuaskan validasi controller\n- id + label + lat + lng + stream_url → dipakai oleh Camera.create() di model\n\nField name/ip_address/location akan diabaikan oleh model tapi harus ada agar controller tidak menolak request."
          }
        },
