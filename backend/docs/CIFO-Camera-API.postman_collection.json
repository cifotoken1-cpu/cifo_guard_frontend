          "name": "POST Tambah Kamera Baru (workaround dual-field)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/api/cameras",
