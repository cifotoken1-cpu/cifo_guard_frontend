        {
          "name": "GET /incidents/:id/timeline",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Timeline berupa array', () => {",
                  "  const body = pm.response.json();",
                  "  const timeline = body?.data;",
                  "  pm.expect(Array.isArray(timeline)).to.be.true;",
                  "  console.log('Timeline entries:', timeline.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/incidents/{{INCIDENT_ID}}/timeline",
              "host": ["{{BASE_URL}}"],
              "path": ["incidents", "{{INCIDENT_ID}}", "timeline"]
            },
            "description": "Get timeline/history aktivitas incident."
          }
        },
        {
          "name": "GET /incidents/:id/activities",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Activities ada', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/incidents/{{INCIDENT_ID}}/activities?limit=20",
              "host": ["{{BASE_URL}}"],
              "path": ["incidents", "{{INCIDENT_ID}}", "activities"],
              "query": [{ "key": "limit", "value": "20" }]
            },
            "description": "Get log aktivitas incident."
          }
        }
      ]
    },
    {
      "name": "06 — Escalate",
      "item": [
        {
          "name": "POST /incidents/:id/escalate — eskalasi ke supervisor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Eskalasi berhasil', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  console.log('Escalation result:', JSON.stringify(body.data));",
                  "});"
