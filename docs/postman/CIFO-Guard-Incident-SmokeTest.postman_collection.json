    {
      "name": "07 — Resolve & Close",
      "item": [
        {
          "name": "PATCH /incidents/:id — → RESOLVED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status = RESOLVED', () => {",
                  "  const body = pm.response.json();",
                  "  const incident = body?.data || body;",
                  "  pm.expect(incident.status).to.equal('RESOLVED');",
                  "});",
                  "pm.test('resolvedAt tersedia', () => {",
                  "  const body = pm.response.json();",
                  "  const incident = body?.data || body;",
                  "  pm.expect(incident.resolvedAt || incident.updatedAt).to.exist;",
                  "  console.log('resolvedAt:', incident.resolvedAt);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/incidents/{{INCIDENT_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["incidents", "{{INCIDENT_ID}}"]
            },
            "description": "Resolve incident — status → RESOLVED."
          }
        },
        {
          "name": "PATCH /incidents/:id — → CLOSED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status = CLOSED', () => {",
                  "  const body = pm.response.json();",
                  "  const incident = body?.data || body;",
                  "  pm.expect(incident.status).to.equal('CLOSED');",
                  "});"
                ],
